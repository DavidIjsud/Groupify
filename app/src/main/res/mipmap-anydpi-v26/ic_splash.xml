<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash adaptive icon (API 26+). On API 31+ the SplashScreen API clips this to a
    circle; the violet glow lives in the background layer, the brand mark in the
    foreground layer. Pre-API-26 devices use mipmap-anydpi/ic_splash.xml instead.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_splash_background" />
    <foreground android:drawable="@drawable/ic_splash_foreground" />
</adaptive-icon>
